# 服务端配置示例。复制为 .env 后填入真实值。
# 本文件中的所有变量都只在服务端进程读取，绝不能暴露给前端：
# 不要加 VITE_ 前缀，不要写进 index.html，也不要提交真实密钥。

# ---- 服务端默认模型（任选一种接口格式） ----
# anthropic | openai-responses | openai-chat-completions
# 留空时：检测到 OPENAI_API_KEY 就用 openai-responses，否则保持原有 anthropic。
SCHEDULE_API_FORMAT=anthropic

# Anthropic 格式使用下面两个变量。
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# 两种 OpenAI 格式都使用下面两个变量。BASE_URL 应包含 /v1，
# 服务端会按格式追加 /responses 或 /chat/completions；也接受完整端点地址。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 使用的模型。默认值按接口格式分别为 claude-opus-5 或 gpt-5.5。
SCHEDULE_MODEL=

# 运行模式：留空按是否有密钥自动判断；
# demo = 强制演示模式，返回固定样例并在界面标明，仅用于演示和测试；
# live = 强制真实模式，没有密钥时报「未配置」而不降级。
SCHEDULE_MODE=

# 服务端口，前端开发代理默认指向 8787。
PORT=8787
# Docker 映射到宿主机的端口，仅供 compose.yaml 使用。
SCHEDULE_HTTP_PORT=8787

# ---- 资源与费用上限 ----
# 单张图片最大字节数，默认 10 MB。
SCHEDULE_MAX_IMAGE_BYTES=10485760
# 通知文本最大字符数。
SCHEDULE_MAX_NOTICE_CHARS=4000
# 每个来源 IP 每分钟的识别/解析请求数。
SCHEDULE_RATE_LIMIT_PER_MINUTE=10
# 同时在途的上游请求数上限。
SCHEDULE_MAX_CONCURRENT=4
# 单次上游调用超时（毫秒）。默认 4 分 30 秒，前端另有 5 分钟整体等待上限。
SCHEDULE_UPSTREAM_TIMEOUT_MS=270000
# 单次调用的输出 token 上限，兼作费用上限的一部分。
SCHEDULE_MAX_OUTPUT_TOKENS=8000

# 生产模式下由服务端托管的前端产物目录。
SCHEDULE_STATIC_DIR=dist
